#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${SETUP_STATE_DIR:-$ROOT/state/setup}"
PREFERENCES_FILE="$STATE_DIR/preferences.json"

action="${1:-plan}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

mode="${SETUP_MODE:-auto}"
interface="${AGENT_INTERFACE:-unspecified}"
provider="${GIT_PROVIDER:-auto}"

usage() {
  cat <<'EOF'
Usage: scripts/setup <plan|apply|status> [options]

Options:
  --mode <auto|devcontainer|host|guidance>
  --interface <name>
  --provider <auto|github|gitlab|bitbucket|git|none>

Environment equivalents:
  SETUP_MODE, AGENT_INTERFACE, GIT_PROVIDER, SETUP_STATE_DIR
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --mode)
      [[ "$#" -ge 2 ]] || die '--mode requires a value'
      mode="$2"
      shift 2
      ;;
    --interface)
      [[ "$#" -ge 2 ]] || die '--interface requires a value'
      interface="$2"
      shift 2
      ;;
    --provider)
      [[ "$#" -ge 2 ]] || die '--provider requires a value'
      provider="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

case "$action" in
  plan|apply|status) ;;
  *)
    usage >&2
    die "unknown action: $action"
    ;;
esac

case "$mode" in
  auto|devcontainer|host|guidance) ;;
  *) die "unsupported mode: $mode" ;;
esac

case "$provider" in
  auto|github|gitlab|bitbucket|git|none) ;;
  *) die "unsupported provider: $provider" ;;
esac

if [[ "$interface" == *$'\n'* || "$interface" == *$'\r'* || -z "$interface" ]]; then
  die 'interface must be a non-empty, single-line label'
fi

in_container=false
if [[ -n "${REMOTE_CONTAINERS:-}" || -n "${CODESPACES:-}" || -f /.dockerenv || -f /run/.containerenv ]]; then
  in_container=true
fi

resolved_mode="$mode"
if [[ "$resolved_mode" == auto ]]; then
  if [[ "$in_container" == true ]]; then
    resolved_mode=devcontainer
  else
    resolved_mode=host
  fi
fi

resolved_provider="$provider"
if [[ "$resolved_provider" == auto ]]; then
  if command -v gh >/dev/null 2>&1; then
    resolved_provider=github
  elif command -v glab >/dev/null 2>&1; then
    resolved_provider=gitlab
  else
    resolved_provider=git
  fi
fi

command_state() {
  if command -v "$1" >/dev/null 2>&1; then
    printf 'available'
  else
    printf 'not installed'
  fi
}

print_plan() {
  printf 'Agent-guided setup plan\n'
  printf '  requested mode: %s\n' "$mode"
  printf '  resolved mode:  %s\n' "$resolved_mode"
  printf '  context:        %s\n' "$([[ "$in_container" == true ]] && printf 'container' || printf 'host')"
  printf '  interface:      %s\n' "$interface"
  printf '  provider:       %s\n' "$resolved_provider"
  printf '\nDetected commands:\n'
  for command_name in git jq make rg gh glab docker devcontainer shellcheck; do
    printf '  %-12s %s\n' "$command_name" "$(command_state "$command_name")"
  done

  printf '\nSteps:\n'
  printf '  1. Confirm the workspace trust domain and execution mode.\n'
  printf '  2. Materialize ignored runtime directories and local preferences.\n'
  printf '  3. Validate the portable workspace definition.\n'
  printf '  4. Configure Git identity and provider authentication separately.\n'
  printf '  5. Register repositories, review the missing set, then authorize cloning.\n'

  printf '\nRecommendations:\n'
  case "$resolved_mode" in
    devcontainer)
      printf '  - Keep Git identity and provider credentials scoped to the container context.\n'
      if [[ "$in_container" != true ]]; then
        printf '  - Start the devcontainer before applying this profile.\n'
      fi
      ;;
    host)
      printf '  - Verify global Git identity and the active credential context before use.\n'
      if [[ "$in_container" == true ]]; then
        printf '  - Run the host profile outside the container so checks reflect the host.\n'
      fi
      ;;
    guidance)
      printf '  - Present commands one at a time and wait for the operator to run them.\n'
      ;;
  esac

  case "$resolved_provider" in
    github)
      printf '  - Use gh auth status to verify the intended account before network actions.\n'
      ;;
    gitlab)
      printf '  - Use glab auth status when glab is available, or verify Git credentials manually.\n'
      ;;
    bitbucket)
      printf '  - Verify the selected SSH key or HTTPS credential helper before cloning.\n'
      ;;
    git)
      printf '  - Configure a suitable Git credential helper or SSH identity for each remote.\n'
      ;;
    none) ;;
  esac

  if [[ "$interface" != unspecified ]]; then
    printf '  - Keep %s integration optional and route it through the documented make targets.\n' "$interface"
  fi

  printf '\nNo authentication, installation, cloning, or remote changes were performed.\n'
}

if [[ "$action" == status ]]; then
  if [[ ! -f "$PREFERENCES_FILE" ]]; then
    printf 'No saved setup preferences. Run make setup after choosing a profile.\n'
    exit 0
  fi
  command -v jq >/dev/null 2>&1 || die 'jq is required to read saved preferences'
  jq . "$PREFERENCES_FILE"
  exit 0
fi

print_plan

if [[ "$action" == plan ]]; then
  exit 0
fi

if [[ "$resolved_mode" == guidance ]]; then
  die 'guidance mode is read-only; the operator must run an apply step in host or devcontainer mode'
fi

if [[ "$resolved_mode" == devcontainer && "$in_container" != true ]]; then
  die 'devcontainer mode must be applied from inside the devcontainer'
fi

if [[ "$resolved_mode" == host && "$in_container" == true ]]; then
  die 'host mode must be applied outside the devcontainer'
fi

for command_name in bash git jq make rg; do
  command -v "$command_name" >/dev/null 2>&1 || die "required command not found: $command_name"
done

"$ROOT/scripts/bootstrap"
"$ROOT/scripts/validate"

mkdir -p "$STATE_DIR"
preferences_tmp="$PREFERENCES_FILE.tmp"
jq -n \
  --arg mode "$resolved_mode" \
  --arg interface "$interface" \
  --arg provider "$resolved_provider" \
  '{version: 1, mode: $mode, interface: $interface, provider: $provider}' \
  >"$preferences_tmp"
mv "$preferences_tmp" "$PREFERENCES_FILE"

printf '\nSaved local preferences to %s\n' "$PREFERENCES_FILE"
printf 'Next: configure identity and authentication, then register repositories.\n'
