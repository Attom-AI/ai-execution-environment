#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib.sh
source "$ROOT/scripts/lib.sh"

require_command git
validate_manifest

count=0
while IFS=$'\t' read -r name _url relative_path; do
  target="$ROOT/$relative_path"
  count=$((count + 1))

  if [[ ! -d "$target/.git" ]]; then
    printf 'skipping %s; checkout is missing (%s)\n' "$name" "$relative_path"
    continue
  fi

  printf 'fetching %s\n' "$name"
  git -C "$target" fetch --prune
done < <(repo_rows)

if [[ "$count" -eq 0 ]]; then
  printf 'no repositories configured in %s\n' "$REPOS_MANIFEST"
fi

