{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./platform/validate.sh)",
      "Bash(./platform/tests/*)",
      "Bash(./platform/install/doctor.sh)",
      "Bash(./platform/install/setup.sh plan *)",
      "Bash(./platform/install/setup.sh status)",
      "Bash(./platform/repositories/status.sh)",
      "Bash(./platform/runtime/scripts/list.sh)",
      "Bash(./platform/context/scripts/hydrate.sh *)",
      "Bash(./architecture/sync-scaffold.sh)",
      "Bash(jq *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.local/state/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.local/state/**)",
      "Edit(./repos/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/platform/interfaces/claude/hooks/guard-outbound.sh"
          }
        ]
      }
    ]
  }
}
