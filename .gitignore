# Managed repositories are independent Git checkouts.
/repos/*
!/repos/.gitkeep

# Temporary worktrees and local runtime data are never committed.
/worktrees/*
!/worktrees/.gitkeep
/state/*
!/state/.gitkeep
/scratch/*
!/scratch/.gitkeep

# Local environment and editor state.
.env
.env.*
!.env.example
.DS_Store
.idea/
*.swp

